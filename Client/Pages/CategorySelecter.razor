@inherits BaseComponent

<div class="custom-select-wrapper">
    @if (Categories != null) {
        <select id="CategorySelecter" name="category" class="modern-select" value="@Id.Value" @onchange="OnCategoryChanged">
            <option value="0" disabled>-- Bitte wähle eine Kategorie --</option>
        
            @foreach (var category in Categories) {
                <option value="@category.Id.Value">@category.Name</option>
            }
        </select>
        <span class="custom-arrow"></span>
    } else if (ErrorMessage != string.Empty) {
        <ErrorPopup IsVisible="true" ErrorMessage="@ErrorMessage" />
    }
</div>